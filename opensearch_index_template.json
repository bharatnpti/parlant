{
  "index_patterns": ["parlant-logs-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "index.refresh_interval": "5s",
      "index.mapping.total_fields.limit": 2000
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "timestamp": {
          "type": "float"
        },
        "level": {
          "type": "keyword"
        },
        "log_level": {
          "type": "keyword"
        },
        "event_type": {
          "type": "keyword"
        },
        "service": {
          "type": "keyword"
        },
        "service_type": {
          "type": "keyword"
        },
        "service_name": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "cluster_name": {
          "type": "keyword"
        },
        "hostname": {
          "type": "keyword"
        },
        "pod_name": {
          "type": "keyword"
        },
        "namespace": {
          "type": "keyword"
        },
        "trace_id": {
          "type": "keyword"
        },
        "span_id": {
          "type": "keyword"
        },
        "request_id": {
          "type": "keyword"
        },
        "correlation_id": {
          "type": "keyword"
        },
        "scopes": {
          "type": "keyword"
        },
        "model": {
          "type": "keyword"
        },
        "schema": {
          "type": "keyword"
        },
        "response_schema": {
          "type": "keyword"
        },
        "model_used": {
          "type": "keyword"
        },
        "prompt_length": {
          "type": "integer"
        },
        "prompt": {
          "type": "text",
          "analyzer": "standard",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "request_parameters": {
          "type": "object"
        },
        "strict_mode": {
          "type": "boolean"
        },
        "duration_seconds": {
          "type": "float"
        },
        "usage": {
          "properties": {
            "prompt_tokens": {
              "type": "integer"
            },
            "completion_tokens": {
              "type": "integer"
            },
            "total_tokens": {
              "type": "integer"
            },
            "cached_tokens": {
              "type": "integer"
            }
          }
        },
        "response_content": {
          "type": "object"
        },
        "response_content_raw": {
          "type": "text"
        },
        "raw_response_content": {
          "type": "text"
        },
        "parsed_json_content": {
          "type": "object"
        },
        "validated_response_content": {
          "type": "object"
        },
        "validated_response_content_raw": {
          "type": "text"
        },
        "event": {
          "type": "text",
          "analyzer": "standard"
        },
        "message": {
          "type": "text",
          "analyzer": "standard"
        }
      }
    }
  }
}
